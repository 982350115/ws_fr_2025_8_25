<?xml version="1.0" encoding="UTF-8"?>
<robot name="fairino16_gripper_robot">
    
    <group name="manipulator">
        <joint name="j1"/>
        <joint name="j2"/>
        <joint name="j3"/>
        <joint name="j4"/>
        <joint name="j5"/>
        <joint name="j6"/>
    </group>

    <group name="gripper">
        <joint name="gripper_left_joint"/>
    </group>

    <mimic joint="gripper_right_joint" mimic="gripper_left_joint" multiplier="-1.0" offset="0.0"/>

    <group_state name="home" group="manipulator">
        <joint name="j1" value="0"/>
        <joint name="j2" value="0"/>
        <joint name="j3" value="0"/>
        <joint name="j4" value="0"/>
        <joint name="j5" value="0"/>
        <joint name="j6" value="0"/>
    </group_state>

    <group_state name="close" group="gripper">
        <joint name="gripper_left_joint" value="0.0"/>
        </group_state>

    <group_state name="open" group="gripper">
        <joint name="gripper_left_joint" value="-0.01"/>
        </group_state>

    <end_effector name="ctpm2f20_eef" parent_link="wrist3_link" group="gripper" parent_group="manipulator"/>

    <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base_link"/>

    <disable_collisions link1="base_link" link2="shoulder_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="upperarm_link" reason="Never"/>
    <disable_collisions link1="base_link" link2="wrist1_link" reason="Never"/>
    <disable_collisions link1="forearm_link" link2="shoulder_link" reason="Never"/>
    <disable_collisions link1="forearm_link" link2="upperarm_link" reason="Adjacent"/>
    <disable_collisions link1="forearm_link" link2="wrist1_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_base_link" link2="gripper_body_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_base_link" link2="gripper_left_link" reason="Never"/>
    <disable_collisions link1="gripper_base_link" link2="gripper_right_link" reason="Never"/>
    <disable_collisions link1="gripper_base_link" link2="wrist1_link" reason="Never"/>
    <disable_collisions link1="gripper_base_link" link2="wrist2_link" reason="Default"/>
    <disable_collisions link1="gripper_base_link" link2="wrist3_link" reason="Adjacent"/>
    
    <disable_collisions link1="gripper_body_link" link2="gripper_left_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_body_link" link2="gripper_right_link" reason="Adjacent"/>
    
    <disable_collisions link1="gripper_body_link" link2="wrist1_link" reason="Never"/>
    <disable_collisions link1="gripper_body_link" link2="wrist2_link" reason="Never"/>
    <disable_collisions link1="gripper_body_link" link2="wrist3_link" reason="Default"/>
    
    <disable_collisions link1="gripper_left_link" link2="wrist1_link" reason="Never"/>
    <disable_collisions link1="gripper_left_link" link2="wrist2_link" reason="Never"/>
    <disable_collisions link1="gripper_left_link" link2="wrist3_link" reason="Never"/>
    
    <disable_collisions link1="gripper_right_link" link2="wrist1_link" reason="Never"/>
    <disable_collisions link1="gripper_right_link" link2="wrist2_link" reason="Never"/>
    <disable_collisions link1="gripper_right_link" link2="wrist3_link" reason="Never"/>
    
    <disable_collisions link1="shoulder_link" link2="upperarm_link" reason="Adjacent"/>
    <disable_collisions link1="shoulder_link" link2="wrist1_link" reason="Never"/>
    <disable_collisions link1="wrist1_link" link2="wrist2_link" reason="Adjacent"/>
    <disable_collisions link1="wrist1_link" link2="wrist3_link" reason="Never"/>
    <disable_collisions link1="wrist2_link" link2="wrist3_link" reason="Adjacent"/>
</robot>
