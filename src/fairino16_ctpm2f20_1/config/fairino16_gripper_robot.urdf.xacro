<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fairino16_gripper_robot">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import fairino16_gripper_robot urdf file -->
    <xacro:include filename="fairino16_ctpm2f20.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="fairino16_gripper_robot.ros2_control.xacro" />


    <xacro:fairino16_gripper_robot_ros2_control name="fairino_sim" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
